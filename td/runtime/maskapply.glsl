// PaintWeb — применение маски слоя «Источник».
//
// Входы: sTD2DInputs[0] = источник (src_level)
//        sTD2DInputs[1] = маска (слой bufm, премультиплицированный белый)
//
// Источник умножается на альфу маски: где маска пуста — источника не видно,
// где залита — видно полностью. Так «рисовать маску» на слое «Источник»
// означает «проявлять картинку», а ластик по этому слою — прятать её.
//
// Почему отдельный шейдер, а не levelTOP + multiplyTOP, как было раньше:
// levelTOP не умеет переносить альфу в RGB, поэтому умножение шло на константу
// (low/high = 1.0) и картинка выходила нетронутой — в TouchDesigner маска не
// влияла ни на что, хотя в браузере работала. Здесь альфа читается напрямую.

out vec4 fragColor;

void main(){
    vec4 s = texture(sTD2DInputs[0], vUV.st);
    vec4 m = texture(sTD2DInputs[1], vUV.st);
    float k = clamp(m.a, 0.0, 1.0);
    // Источник приходит премультиплицированным, поэтому умножения обеих частей
    // на одну и ту же величину достаточно: инвариант rgb = color * a сохраняется.
    fragColor = vec4(s.rgb * k, s.a * k);
}
