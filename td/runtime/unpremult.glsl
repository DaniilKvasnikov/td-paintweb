// PaintWeb — снятие премультипликации для картинок, которые уезжают в браузер.
//
// Слой краски живёт в TD с ПРЕМУЛЬТИПЛИРОВАННОЙ альфой: смешивание штампа с
// прозрачным фоном даёт rgb = color * a, и композит (overTOP) считает именно так.
// Но браузер получает PNG и по стандарту трактует его как STRAIGHT alpha, то есть
// домножает RGB на альфу ЕЩЁ РАЗ — на мягких краях мазок темнел бы.
// Поэтому перед отправкой делим RGB на альфу: в браузер уходят обычные пиксели.
//
// Вход: sTD2DInputs[0] — вырезанная область слоя.

out vec4 fragColor;

void main(){
    vec4 c = texture(sTD2DInputs[0], vUV.st);
    // при alpha = 0 цвет не определён: оставляем нули, делить нельзя
    float a = max(c.a, 1.0 / 4096.0);
    vec3 rgb = clamp(c.rgb / a, 0.0, 1.0);
    fragColor = vec4(c.a > 0.0 ? rgb : vec3(0.0), c.a);
}
