// PaintWeb — слой монотонного цвета, проявляемый маской.
//
// Входы: sTD2DInputs[0] = цвет (constantTOP, RGB — цвет, альфа — интенсивность)
//        sTD2DInputs[1] = маска (слой bufm, премультиплицированный белый)
//
// Результат: цвет, премультиплицированный по своей альфе и по альфе маски.
// Отдельный шейдер, а не общий maskapply.glsl: тот умножает на альфу маски уже
// готовую картинку источника (её альфа — своя), а здесь важна ещё и альфа цвета,
// которой и задаётся интенсивность слоя.

out vec4 fragColor;

void main(){
    vec4 c = texture(sTD2DInputs[0], vUV.st);
    vec4 m = texture(sTD2DInputs[1], vUV.st);
    float k = clamp(c.a, 0.0, 1.0) * clamp(m.a, 0.0, 1.0);
    fragColor = vec4(c.rgb * k, k);
}
